<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Template: `harness install-agent` fills in @HOME@ and @PYTHON@ and loads it as a user LaunchAgent. -->
<plist version="1.0">
<dict>
  <key>Label</key><string>ai.harness.watchdog</string>
  <key>ProgramArguments</key>
  <array>
    <string>@PYTHON@</string>
    <string>-m</string>
    <string>harness</string>
    <string>watch</string>
  </array>
  <key>WorkingDirectory</key><string>@HOME@</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>AIH_HOME</key><string>@HOME@</string>
    <key>PATH</key><string>/usr/bin:/bin:/usr/sbin:/sbin</string>
  </dict>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <!-- Interactive keeps the watchdog and the llama-server it spawns off the efficiency cores. -->
  <key>ProcessType</key><string>Interactive</string>
  <key>StandardOutPath</key><string>@HOME@/logs/watchdog.log</string>
  <key>StandardErrorPath</key><string>@HOME@/logs/watchdog.log</string>
</dict>
</plist>
