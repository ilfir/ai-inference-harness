# Strata as its own planner configures it on a 64 GB Mac: experts streamed from the SSD, no MTP ("S-A").
# About 35-40 GB of memory instead of ~57 GB, but decode measured at 0.49-0.55x of llama.cpp (15-17 tok/s).
# Useful when the Mac must keep memory free for other work.
DESCRIPTION="Strata, experts streamed from SSD, no MTP, 2 slots (S-A, low memory, ~0.5x llama.cpp)"
ALIAS="qwen3.8-flash-next"
CTX=131072
PARALLEL=2
MTP=0
SPEC=2
SUFFIX_DRAFT=0
STREAM=1
KV_TYPE=""
CONV_CACHE_MIB=2048
BATCH_MTP=0
PORT=8080
HOST=0.0.0.0
STRATA_API_KEY=""
GPU_BUDGET_GB=36
EXTRA_ARGS=""
