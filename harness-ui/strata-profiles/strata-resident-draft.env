# Strata resident with speculative decoding and 2 slots: the trial's "R-C" (MTP layer + the engine's own
# prompt-lookup drafter). Fastest measured at long context (1.62x llama.cpp at 59k) but wired memory reached
# 61 GB and swap grew ~0.9 GB during the trial. Needs the packed MTP layer (prepare.sh --download-mtp).
DESCRIPTION="Strata resident + MTP draft, 2 slots, 128k ctx (R-C, fastest, swap risk)"
ALIAS="qwen3.8-flash-next"
CTX=131072
PARALLEL=2
MTP=1
SPEC=2
SUFFIX_DRAFT=default
STREAM=0
KV_TYPE=""
CONV_CACHE_MIB=2048
BATCH_MTP=0
PORT=8080
HOST=0.0.0.0
STRATA_API_KEY=""
GPU_BUDGET_GB=59
EXTRA_ARGS=""
