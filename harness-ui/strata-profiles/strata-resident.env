# Strata (ai-inference-strata trial) with the model forced resident on the GPU: the "R-A" configuration that
# strata-backend.sh runs as the production switch. Measured 1.34-1.50x llama.cpp decode (44 tok/s short, 42 tok/s
# at 59k ctx), 1.06-1.17x prefill, 0 MB swap growth in the 35-minute soak. Wired memory peaks at ~59 GB, so this is
# outside Strata's own tested envelope on 64 GB; keep the box otherwise idle.
# Keys are the environment knobs of <strata home>/scripts/strata-start.sh (read by its make-config.py).
DESCRIPTION="Strata, weights resident, no MTP, 1 slot, 128k ctx (R-A, ~1.35x llama.cpp)"
ALIAS="qwen3.8-flash-next"
CTX=131072
PARALLEL=1
MTP=0
SPEC=2
SUFFIX_DRAFT=0
STREAM=0
KV_TYPE=""
CONV_CACHE_MIB=2048
BATCH_MTP=0
PORT=8080
HOST=0.0.0.0
STRATA_API_KEY=""
# Wired memory this configuration reaches (weights 47 GB + buffers + KV), used by preflight.
GPU_BUDGET_GB=57
EXTRA_ARGS=""
