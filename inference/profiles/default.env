# Qwen3.8-Flash-Next, GSQ-RCO IQ3_XXS + MTP Q8_0 head, 128k context.
# Shard 1 (47 GB) is wired on the GPU; shard 2 (28.8 GB n-gram table) stays mmap'd on SSD.
DESCRIPTION="Qwen3.8-Flash-Next IQ3_XXS + MTP, 128k ctx"
MODELS_DIR="$HOME/models/qwen3.8-flash-next"

MODEL_REPO="ISTA-DASLab/Qwen3.8-Flash-Next-GSQ-RCO-GGUF"
MODEL_INCLUDE="IQ3_XXS/*"
MODEL_FILE="IQ3_XXS/Qwen3.8-Flash-Next-GSQ-RCO-IQ3_XXS-00001-of-00002.gguf"

MTP_REPO="unsloth/Qwen3.8-Flash-Next-GGUF"
MTP_FILE="MTP/mtp-Qwen3.8-Flash-Next-Q8_0.gguf"
DRAFT_N_MAX=1

ALIAS="qwen3.8-flash-next"
CTX=131072
PARALLEL=2
PORT=8080
CACHE_TYPE=q8_0
# Host-RAM prompt cache cap (MiB) for idle sessions; keeps the box out of swap.
CACHE_RAM_MB=2048

# GPU memory this profile needs (weights + MTP + KV + buffers), used by preflight.
GPU_BUDGET_GB=54
# Profile the watchdog switches to if this one dies with a Metal OOM.
FALLBACK_PROFILE="chat-nomtp"
EXTRA_ARGS=""
