# Baseline for comparison: dense Qwen3.8-27B UD-Q4_K_XL (already in the HF cache on the Studio).
DESCRIPTION="Qwen3.8-27B UD-Q4_K_XL baseline, 32k ctx"
MODELS_DIR="$HOME/models/qwen3.8-27b"

MODEL_REPO="unsloth/Qwen3.8-27B-GGUF"
MODEL_INCLUDE="Qwen3.8-27B-UD-Q4_K_XL.gguf"
MODEL_FILE="Qwen3.8-27B-UD-Q4_K_XL.gguf"

MTP_REPO=""
MTP_FILE=""

ALIAS="qwen3.8-27b"
CTX=32768
PARALLEL=2
PORT=8080
CACHE_TYPE=q8_0
# Host-RAM prompt cache cap (MiB) for idle sessions; keeps the box out of swap.
CACHE_RAM_MB=8192
GPU_BUDGET_GB=22
FALLBACK_PROFILE=""
EXTRA_ARGS=""
