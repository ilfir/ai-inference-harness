# Same as default plus the vision projector: chat requests may carry image parts.
# Costs ~0.9 GB more GPU memory. Each image costs context tokens, not memory: a 256x256 image is about
# 64 tokens; a 1600x1600 image about 2500 tokens and ~11 s of prefill on the M1 Ultra.
DESCRIPTION="Qwen3.8-Flash-Next IQ3_XXS + MTP + vision, 128k ctx"
MODELS_DIR="$HOME/models/qwen3.8-flash-next"

MODEL_REPO="ISTA-DASLab/Qwen3.8-Flash-Next-GSQ-RCO-GGUF"
MODEL_INCLUDE="IQ3_XXS/*"
MODEL_FILE="IQ3_XXS/Qwen3.8-Flash-Next-GSQ-RCO-IQ3_XXS-00001-of-00002.gguf"

MTP_REPO="unsloth/Qwen3.8-Flash-Next-GGUF"
MTP_FILE="MTP/mtp-Qwen3.8-Flash-Next-Q8_0.gguf"
DRAFT_N_MAX=1

# Multimodal projector (0.9 GB, BF16). Same MODELS_DIR as default, so the weights are shared.
MMPROJ_REPO="ISTA-DASLab/Qwen3.8-Flash-Next-GSQ-RCO-GGUF"
MMPROJ_FILE="mmproj-Qwen3.8-Flash-Next-BF16.gguf"
# llama.cpp notes Qwen-VL wants >= 1024 image tokens for grounding (coordinates, boxes). Plain
# description works without it. Set to 1024 for grounding tasks; empty keeps llama.cpp's default.
IMAGE_MIN_TOKENS=""

ALIAS="qwen3.8-flash-next"
CTX=131072
PARALLEL=2
PORT=8080
CACHE_TYPE=q8_0
# Host-RAM prompt cache cap (MiB) for idle sessions; keeps the box out of swap.
CACHE_RAM_MB=2048

# GPU memory this profile needs (weights + MTP + projector + KV + buffers), used by preflight.
GPU_BUDGET_GB=56
# Profile the watchdog switches to if this one dies with a Metal OOM (text only).
FALLBACK_PROFILE="chat-nomtp"
EXTRA_ARGS=""
