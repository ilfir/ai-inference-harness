# Fallback: no MTP head, 32k context. Used by the watchdog after a Metal OOM.
DESCRIPTION="Qwen3.8-Flash-Next IQ3_XXS, no MTP, 32k ctx (fallback)"
MODELS_DIR="$HOME/models/qwen3.8-flash-next"

MODEL_REPO="ISTA-DASLab/Qwen3.8-Flash-Next-GSQ-RCO-GGUF"
MODEL_INCLUDE="IQ3_XXS/*"
MODEL_FILE="IQ3_XXS/Qwen3.8-Flash-Next-GSQ-RCO-IQ3_XXS-00001-of-00002.gguf"

MTP_REPO=""
MTP_FILE=""
# Vision projector (mmproj); empty = text only. The vision profile sets it.
MMPROJ_REPO=""
MMPROJ_FILE=""

ALIAS="qwen3.8-flash-next"
CTX=32768
PARALLEL=2
PORT=8080
CACHE_TYPE=q8_0
# Host-RAM prompt cache cap (MiB) for idle sessions; keeps the box out of swap.
CACHE_RAM_MB=2048
GPU_BUDGET_GB=50
FALLBACK_PROFILE=""
EXTRA_ARGS=""
