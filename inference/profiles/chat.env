# Same weights as default, 32k context: more page cache left for the n-gram table.
DESCRIPTION="Qwen3.8-Flash-Next IQ3_XXS + MTP, 32k ctx"
MODELS_DIR="$HOME/models/qwen3.8-flash-next"

MODEL_REPO="ISTA-DASLab/Qwen3.8-Flash-Next-GSQ-RCO-GGUF"
MODEL_INCLUDE="IQ3_XXS/*"
MODEL_FILE="IQ3_XXS/Qwen3.8-Flash-Next-GSQ-RCO-IQ3_XXS-00001-of-00002.gguf"

MTP_REPO="unsloth/Qwen3.8-Flash-Next-GGUF"
MTP_FILE="MTP/mtp-Qwen3.8-Flash-Next-Q8_0.gguf"
DRAFT_N_MAX=1

ALIAS="qwen3.8-flash-next"
CTX=32768
PARALLEL=2
PORT=8080
CACHE_TYPE=q8_0
GPU_BUDGET_GB=53
FALLBACK_PROFILE="chat-nomtp"
EXTRA_ARGS=""
